# Frontend public environment variables (no secrets)
# Local (Docker compose)
VITE_ENVIRONMENT=local
VITE_USERS_API_BASE_URL=http://localhost:8082
VITE_SHOPPINGLIST_API_BASE_URL=http://localhost:8080
VITE_PRODUCTCATALOG_API_BASE_URL=http://localhost:8083

# Cloud (Azure Static Web Apps example)
# VITE_ENVIRONMENT=cloud
# VITE_USERS_API_BASE_URL=https://users-api.example.com
# VITE_SHOPPINGLIST_API_BASE_URL=https://shoppinglist-api.example.com
# VITE_PRODUCTCATALOG_API_BASE_URL=https://productcatalog-api.example.com

# Microsoft Entra / MSAL
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=a6b72a33-ade4-45d3-a2a7-52b88d96f5eb
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/a6b72a33-ade4-45d3-a2a7-52b88d96f5eb/v2.0

# Redirect URIs por ambiente
VITE_ENTRA_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
# VITE_ENTRA_REDIRECT_URI=https://<swa-domain>/auth/callback
# VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=https://<swa-domain>

# Scope delegado de backend MiKompri (debe existir en Entra ID)
# Ejemplo real: api://<backend-app-client-id>/access_as_user
VITE_API_SCOPE=api://36adb79e-9563-4642-8bc9-455358d76273/access_as_user

# Optional CIAM Google route. Enable only after QA registration/redirects are configured.
# No secrets in SPA. Email OTP is not exposed by this increment.
VITE_CIAM_ENABLED=false
VITE_CIAM_CLIENT_ID=
VITE_CIAM_TENANT_ID=
VITE_CIAM_AUTHORITY=
VITE_CIAM_API_SCOPE=
