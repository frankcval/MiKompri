# syntax=docker/dockerfile:1.7

FROM node:24-alpine AS builder
WORKDIR /app

COPY MiKompri.Web/package*.json ./
RUN npm ci

COPY MiKompri.Web/ ./
# Public SPA configuration only; never pass secrets or tokens as build arguments.
ARG VITE_ENVIRONMENT
ARG VITE_USERS_API_BASE_URL
ARG VITE_SHOPPINGLIST_API_BASE_URL
ARG VITE_PRODUCTCATALOG_API_BASE_URL
ARG VITE_ENTRA_CLIENT_ID
ARG VITE_ENTRA_TENANT_ID
ARG VITE_ENTRA_AUTHORITY
ARG VITE_ENTRA_REDIRECT_URI
ARG VITE_ENTRA_POST_LOGOUT_REDIRECT_URI
ARG VITE_API_SCOPE
ARG VITE_CIAM_ENABLED
ARG VITE_CIAM_CLIENT_ID
ARG VITE_CIAM_TENANT_ID
ARG VITE_CIAM_AUTHORITY
ARG VITE_CIAM_API_SCOPE
ENV VITE_ENVIRONMENT=${VITE_ENVIRONMENT}
ENV VITE_USERS_API_BASE_URL=${VITE_USERS_API_BASE_URL}
ENV VITE_SHOPPINGLIST_API_BASE_URL=${VITE_SHOPPINGLIST_API_BASE_URL}
ENV VITE_PRODUCTCATALOG_API_BASE_URL=${VITE_PRODUCTCATALOG_API_BASE_URL}
ENV VITE_ENTRA_CLIENT_ID=${VITE_ENTRA_CLIENT_ID}
ENV VITE_ENTRA_TENANT_ID=${VITE_ENTRA_TENANT_ID}
ENV VITE_ENTRA_AUTHORITY=${VITE_ENTRA_AUTHORITY}
ENV VITE_ENTRA_REDIRECT_URI=${VITE_ENTRA_REDIRECT_URI}
ENV VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=${VITE_ENTRA_POST_LOGOUT_REDIRECT_URI}
ENV VITE_API_SCOPE=${VITE_API_SCOPE}
ENV VITE_CIAM_ENABLED=${VITE_CIAM_ENABLED}
ENV VITE_CIAM_CLIENT_ID=${VITE_CIAM_CLIENT_ID}
ENV VITE_CIAM_TENANT_ID=${VITE_CIAM_TENANT_ID}
ENV VITE_CIAM_AUTHORITY=${VITE_CIAM_AUTHORITY}
ENV VITE_CIAM_API_SCOPE=${VITE_CIAM_API_SCOPE}
RUN npm run build

FROM nginx:1.27-alpine AS runtime
WORKDIR /usr/share/nginx/html

RUN rm -rf ./*
COPY --from=builder /app/dist ./
COPY MiKompri.Web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
