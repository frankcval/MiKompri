    "ValidAudiences": "api://36adb79e-9563-4642-8bc9-455358d76273,36adb79e-9563-4642-8bc9-455358d76273,mikompri-shoppinglist-api"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,http://127.0.0.1:5173"
  },
  "UsersApi": {
